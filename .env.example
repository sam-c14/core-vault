# CoreVault Environment Variables
PORT=8080
RUST_LOG=info,corevault=debug

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://cv_user:cv_password@localhost:5432/corevault_db

# Cache & Idempotency Store (Valkey 7.2 / Redis compatible)
VALKEY_URL=redis://localhost:6379

# Cryptography & Security
# 256-bit AES master key in hex format for application-level PII encryption
COREVAULT_MASTER_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# JWT Secret for staff session tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_123456
