{
  "info": {
    "_postman_id": "cba00001-2026-4000-8000-000000000001",
    "name": "CoreVault Core Banking API (Complete Edition)",
    "description": "Comprehensive Postman Collection for CoreVault V1 — 100% Free & Open-Source Core Banking Engine in Rust.\n\nOrganized by domain crates:\n1. Health & Infrastructure Probes\n2. Staff Authentication & IAM (`cv-auth`)\n3. Account Management & NUBAN (`cv-account-manager` & `cv-nuban-validator`)\n4. Account Controls & Liens (`cv-account-manager`)\n5. Double-Entry Transfers (`cv-double-entry-engine`)\n6. Platform & Jurisdiction Configuration (`cv-platform-config-parser`)\n7. Audit Trail (`cv-audit`)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Infrastructure Probes",
      "description": "Health check endpoints designed for container orchestrators (Kubernetes/Docker), load balancers (Caddy/NGINX), and uptime monitoring systems.",
      "item": [
        {
          "name": "Check Liveness (/health/live)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.service).to.eql(\"corevault-monolith\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": ["{{baseUrl}}"],
              "path": ["health", "live"]
            },
            "description": "Lightweight probe to verify that the HTTP process is responsive."
          },
          "response": []
        },
        {
          "name": "Check Readiness (/health/ready)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"State is READY with DB and Valkey UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"READY\");",
                  "    pm.expect(jsonData.checks.database).to.eql(\"UP\");",
                  "    pm.expect(jsonData.checks.valkey).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Verifies that downstream persistence layers (PostgreSQL and Valkey) are connected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Staff Authentication & IAM (cv-auth)",
      "description": "Powered by the `cv-auth` crate. Implements Argon2id password verification, cryptographic Ed25519/HMAC JWT token issuance, and caller session authorization.",
      "item": [
        {
          "name": "Staff Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token received and saved to environment\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "    pm.expect(jsonData.token_type).to.eql(\"Bearer\");",
                  "    pm.environment.set(\"authToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@corevault.bank\",\n  \"password\": \"AdminSecurePass#2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates bank staff with Argon2id and returns a signed 15-minute access token."
          },
          "response": []
        },
        {
          "name": "Get Authenticated User Identity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Claims contain valid role\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(jsonData.claims.role).to.eql(\"OPERATIONS_OFFICER\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Validates the Bearer JWT token and returns caller identity and permissions."
          },
          "response": []
        },
        {
          "name": "Login Rejection - Invalid Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Invalid password rejected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@corevault.bank\",\n  \"password\": \"WrongGuessPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Verifies that invalid password attempts are rejected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Account Management & NUBAN (cv-account-manager & cv-nuban-validator)",
      "description": "Powered by `cv-account-manager` and `cv-nuban-validator`. Implements the Central Bank of Nigeria (CBN) Mod-10 algorithm for generating 10-digit NUBAN account numbers, account lifecycle state machines, and balance inquiries.",
      "item": [
        {
          "name": "Open Savings Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSerial = Math.floor(100000 + Math.random() * 900000);",
                  "pm.environment.set(\"currentSerial\", randomSerial);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Account created with valid NUBAN\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"SUCCESS\");",
                  "    pm.expect(jsonData.account.account_number).to.have.lengthOf(10);",
                  "    pm.expect(jsonData.account.status).to.eql(\"ACTIVE\");",
                  "    pm.environment.set(\"accountNumber\", jsonData.account.account_number);",
                  "    pm.environment.set(\"sourceAccountId\", jsonData.account.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"account_name\": \"Emeka Okafor Savings\",\n  \"gl_code\": \"2110001\",\n  \"account_type\": \"SAVINGS\",\n  \"currency\": \"NGN\",\n  \"bank_code\": \"{{bankCode}}\",\n  \"serial_number\": {{currentSerial}},\n  \"overdraft_limit\": \"0.00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Creates a retail savings account and generates a verified 10-digit NUBAN."
          },
          "response": []
        },
        {
          "name": "Open Current Account with Overdraft",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSerial = Math.floor(100000 + Math.random() * 900000);",
                  "pm.environment.set(\"currentSerial2\", randomSerial);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Overdraft limit is assigned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.account.overdraft_limit).to.eql(\"50000.00\");",
                  "    pm.environment.set(\"destinationAccountId\", jsonData.account.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"account_name\": \"Lagos Tech Ventures Current\",\n  \"gl_code\": \"2110002\",\n  \"account_type\": \"CURRENT\",\n  \"currency\": \"NGN\",\n  \"bank_code\": \"{{bankCode}}\",\n  \"serial_number\": {{currentSerial2}},\n  \"overdraft_limit\": \"50000.00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
