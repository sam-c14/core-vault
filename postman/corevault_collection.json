        {
          "name": "Account Opening Rejection - Invalid Bank Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Invalid bank code rejected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"ERROR\");",
                  "    pm.expect(jsonData.message).to.include(\"Invalid bank code\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantId}}\",\n  \"customer_id\": \"{{customerId}}\",\n  \"account_name\": \"Invalid Code Test\",\n  \"gl_code\": \"2110001\",\n  \"account_type\": \"SAVINGS\",\n  \"currency\": \"NGN\",\n  \"bank_code\": \"5\",\n  \"serial_number\": 123456,\n  \"overdraft_limit\": \"0.00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Validates that NUBAN generator rejects bank codes not conforming to 3 digits."
          },
          "response": []
        },
        {
          "name": "Get Account by NUBAN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Account inquiry returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.account_number).to.eql(pm.environment.get(\"accountNumber\"));",
                  "    pm.expect(jsonData.status).to.eql(\"ACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}"]
            },
            "description": "Retrieves the account balance and status by 10-digit NUBAN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Account Controls & Liens (cv-account-manager)",
      "description": "Powered by `cv-account-manager`. Enforces compliance restrictions (`POST_NO_DEBIT`, `FROZEN`) and financial liens/holds under CBN regulations.",
      "item": [
        {
          "name": "Place Post-No-Debit (PND)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"PND placed: debits blocked, credits permitted\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.current_status).to.eql(\"POST_NO_DEBIT\");",
                  "    pm.expect(jsonData.can_debit).to.eql(false);",
                  "    pm.expect(jsonData.can_credit).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Suspicious KYC documentation flagged for review\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}/pnd",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}", "pnd"]
            },
            "description": "Places a Post-No-Debit (PND) hold on the account. Debits are forbidden; credits remain allowed."
          },
          "response": []
        },
        {
          "name": "Freeze Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Account frozen: all activity blocked\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.current_status).to.eql(\"FROZEN\");",
                  "    pm.expect(jsonData.can_debit).to.eql(false);",
                  "    pm.expect(jsonData.can_credit).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Court order warrant compliance freeze\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}/freeze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}", "freeze"]
            },
            "description": "Completely freezes account. Both credits and debits are strictly blocked."
          },
          "response": []
        },
        {
          "name": "Activate Account (Restore)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Account restored to ACTIVE\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.current_status).to.eql(\"ACTIVE\");",
                  "    pm.expect(jsonData.can_debit).to.eql(true);",
                  "    pm.expect(jsonData.can_credit).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"KYC verification verified and approved by Compliance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}", "activate"]
            },
            "description": "Lifts restrictions and restores the account to ACTIVE."
          },
          "response": []
        },
        {
          "name": "Place Financial Lien (Hold)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lien placed successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.action).to.eql(\"LIEN_PLACED\");",
                  "    pm.expect(jsonData.placed_lien_amount).to.eql(\"15000.00\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"15000.00\",\n  \"reason\": \"Pending debit card pre-authorization\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}/liens",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}", "liens"]
            },
            "description": "Places a financial hold on the account, reducing available balance without moving funds."
          },
          "response": []
        },
        {
          "name": "Release Financial Lien",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lien released successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.action).to.eql(\"LIEN_RELEASED\");",
                  "    pm.expect(jsonData.released_lien_amount).to.eql(\"15000.00\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"15000.00\",\n  \"reason\": \"Pre-authorization expired or settled\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountNumber}}/liens/release",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{accountNumber}}", "liens", "release"]
            },
            "description": "Releases an active lien, restoring the available balance."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Double-Entry Transfers (cv-double-entry-engine)",
      "description": "Powered by `cv-double-entry-engine`. Enforces the fundamental invariant of double-entry bookkeeping: every transaction consists of at least two posting legs where Total Debits strictly equals Total Credits in the same currency.",
      "item": [
        {
          "name": "Post Balanced Intra-Bank Transfer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "    return v.toString(16);",
                  "});",
                  "pm.request.headers.add({ key: 'Idempotency-Key', value: uuid });"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Transaction committed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"COMMITTED\");",
                  "    pm.expect(jsonData.amount).to.eql(\"25000.00\");",
                  "    pm.expect(jsonData.currency).to.eql(\"NGN\");",
                  "    pm.expect(jsonData.transaction_id).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_account_id\": \"{{sourceAccountId}}\",\n  \"destination_account_id\": \"{{destinationAccountId}}\",\n  \"amount\": \"25000.00\",\n  \"currency\": \"NGN\",\n  \"narration\": \"Payment for electrical installation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/intra",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "intra"]
            },
            "description": "Submits a transfer with automatic Debits == Credits verification."
          },
          "response": []
        },
        {
          "name": "Transfer Rejection - Negative Amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Negative amount validation fails\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"VALIDATION_FAILED\");",
                  "    pm.expect(jsonData.error).to.include(\"strictly positive\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_account_id\": \"{{sourceAccountId}}\",\n  \"destination_account_id\": \"{{destinationAccountId}}\",\n  \"amount\": \"-500.00\",\n  \"currency\": \"NGN\",\n  \"narration\": \"Illegal negative amount transfer attempt\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/intra",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "intra"]
